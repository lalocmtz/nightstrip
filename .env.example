# Required together with DATABASE_URL for live crypto charges. If any live
# requirement is missing, the app stays visibly in demo-credit mode.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Optional. NOWPayments sandbox API (https://api-sandbox.nowpayments.io)
NOWPAYMENTS_SANDBOX=

# Public site URL used for IPN callbacks and invoice redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for live payments. Without it, state is local-file (dev) or
# ephemeral (Vercel), so production charges remain disabled.
DATABASE_URL=

# Optional. Signs the wallet cookie. A demo default is used when unset.
SESSION_SECRET=
