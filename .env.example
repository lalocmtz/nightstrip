# Required together with DATABASE_URL for live crypto charges. Production
# fails closed if any required value is missing; demo fallback is local-only.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Optional. NOWPayments sandbox API (https://api-sandbox.nowpayments.io)
NOWPAYMENTS_SANDBOX=

# Public site URL used for IPN callbacks and invoice redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for live payments. Without it, state is local-file (dev) or
# ephemeral (Vercel), so production charges remain disabled.
DATABASE_URL=

# Required in production. A public demo default is used only in local/test.
SESSION_SECRET=

# Operational kill switch. Set to 1 to stop new invoices while keeping the
# board and existing payment callbacks online.
DISABLE_CLAIMS=0
