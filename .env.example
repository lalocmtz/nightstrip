# Optional. When unset, the app runs in demo-credit mode (no live crypto charges).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Optional. NOWPayments sandbox API (https://api-sandbox.nowpayments.io)
NOWPAYMENTS_SANDBOX=

# Public site URL used for IPN callbacks and invoice redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Neon / Postgres connection string. Without it, state is local-file
# (dev) or in-memory (Vercel). Add Neon for durable production rankings.
DATABASE_URL=

# Optional. Signs the wallet cookie. A demo default is used when unset.
SESSION_SECRET=
